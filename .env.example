# ---------------------------------------------------------------------------
# Contact form delivery
# ---------------------------------------------------------------------------
# Copy this file to .env.local and paste your Resend API key. That is the only
# value you need — submissions go to nexofficeonline@gmail.com by default
# (set in src/data/site.ts as `site.email`).
#
# Get a key: https://resend.com/api-keys
# Sign up with nexofficeonline@gmail.com, otherwise the shared sender below is
# not allowed to deliver to that address.
RESEND_API_KEY=

# Optional overrides -------------------------------------------------------
# Change where briefs are delivered without touching the code.
# CONTACT_TO_EMAIL=nexofficeonline@gmail.com

# Defaults to "Nexoffice <onboarding@resend.dev>", Resend's shared sender,
# which needs no DNS setup but can only deliver to the API key owner's address.
# Once a domain is verified in Resend, set this to send from your own domain:
# CONTACT_FROM_EMAIL="Nexoffice <hello@your-domain.com>"
